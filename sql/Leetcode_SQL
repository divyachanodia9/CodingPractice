from Orders
union 
select dates, string_agg(cast(product_id as varchar), ',') as products
from orders
group by customer_id, dates
order by dates, products

# Auto Repair

select * 
(
select v.value as velocity, l.value as level
from auto_repair l
join auto_repair v
on l.client = v.client and l.auto=v.auto and l.repair_date = v.repair_date
where l.indicator = 'level'
and l.indicator = 'velocity') bq
pivot
(
    count(level)
    for level in ([good],[wrong],[regular])
) pq;


