select
 case when age >= 0 and age < 19 then '0-18' 
      when age >= 19 and age < 26 then '19-25' 
      when age >= 26 and age < 36 then '26-35' 
      when age >= 36 and age < 46 then '36-45' 
      when age >= 46 and age < 61 then '46-60'
      else '60+' end as age_segment,
      ROUND(COUNT(c.comment_id)*1.0/COUNT(DISTINCT p.person_id),2) as avg_comments_per_person 
