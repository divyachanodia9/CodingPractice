with monthlycomment as (
select
 case when age between 0 and 18 then '0-18'
      when age between 19 and 25 then '19-25'
      when age between 26 and 35 then '26-35'
      when age between 36 and 45 then '36-45'
      when age between 46 and 60 then '46-60'
      else '60+' end as age_segment,
      TO_CHAR(c.date,'YYYY-MM') as month,
      count(c.comment_id) as total_comments
from persons p 
join comments c 
on p.person_id = c.person_id
where Extract(year from c.date) = '2023'
group by age_segment, month),
ranked as (
select age_segment, month, total_comments, row_number() over(partition by month order by total_comments desc) as rw
from monthlycomment m)

select age_segment, month, total_comments
from ranked
where rw < 3

